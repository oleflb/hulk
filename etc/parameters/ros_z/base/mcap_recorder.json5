{
  enable: true,
  max_duration: { secs: 3600, nanos: 0 },
  include_raw_images: true,
  raw_image_min_interval: { secs: 0, nanos: 500000000 },
  queue_depth: 8,
  schema_discovery_timeout: { secs: 15, nanos: 0 },
  topics: [
    "behavior/motion_command",
    "camera_matrix",
    "debug/calibrated_intrinsics",
    "debug/global_localization",
    "debug/visual_odometry/previous_left_camera_to_current_left_camera",
    "detected_objects",
    "detected_objects/announce",
    "field_dimensions",
    "field_mark_association/visual_localization",
    "ground_to_robot",
    "head_joints_command",
    "inputs/imu_state",
    "inputs/serial_motor_states",
    "localization",
    "look_around_target_joints",
    "look_at",
    "robot_kinematics",
    "support_foot",
    "visual_odometry/current_left_camera_to_previous_left_camera",
    "visual_odometry/current_left_camera_to_visual_odometer",
  ],
}
