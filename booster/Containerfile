# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Clone SDK
RUN git clone https://github.com/BoosterRobotics/booster_robotics_sdk.git

# # Copy binary installer
# COPY booster-runner-full-webots-k1-0.0.1.run .

# Set working directory to the SDK
WORKDIR /booster_robotics_sdk

# Install SDK
RUN yes | ./install.sh

# Build SDK
RUN mkdir build && cd build && cmake .. && make -j$(nproc)

# Return to root
WORKDIR /

RUN git clone https://gitee.com/booster_robotics/booster_robotics_sdk_ros2
WORKDIR /booster_robotics_sdk_ros2/booster_ros2_interface
