    libcurl4-openssl-dev \
    libsdl2-dev \
    joystick \
    libspdlog-dev \
    libqt5widgets5 \
    qtwayland5 \
    libqt5waylandclient5 \
    libqt5waylandcompositor5 \
    libxkbcommon0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-xkb1 \
    libxcb-xinput0 \
    xkb-data \
    libwayland-client0 \
    libwayland-egl1 \
    libwayland-cursor0 \
    libwayland-server0 \
    libxcb1 \
    libx11-xcb1


