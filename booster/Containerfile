FROM ros:humble-perception-jammy

# Prevent apt from asking questions
ENV DEBIAN_FRONTEND=noninteractive

# Update and install dependencies
RUN apt update -y && \
    apt install -y \
    unzip \
    sudo \
    gdebi-core \
    git \
    lsb-release \
    cmake \
    ninja-build \
    libgtest-dev \
    libgoogle-glog-dev \
